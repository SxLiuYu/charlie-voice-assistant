# Charlie 语音助手 — 环境变量配置
# 复制此文件为 .env，填入你自己的API密钥

# ===== 必需 =====

# 火山引擎ARK (大脑LLM) — https://console.volcengine.com/ark
ARK_KEY=你的ARK密钥
ARK_BASE=https://ark.cn-beijing.volces.com/api/plan/v3
ARK_MODEL=ark-code-latest

# 百度智能云 (ASR语音识别 — 主) / 云知声 Unisound MaaS (ASR降级备用) — https://console.bce.baidu.com/ai/#/ai/speech/overview/index
BAIDU_APP_ID=你的百度APP_ID
BAIDU_API_KEY=你的百度API_KEY
BAIDU_SECRET_KEY=你的百度SECRET_KEY

# 高德地图 (天气查询) — https://console.amap.com
AMAP_KEY=你的高德KEY

# ===== 可选 =====

# 数据/日志目录 (默认: 项目内运行时数据/日志)
ASSISTANT_KID_DATA_DIR=
ASSISTANT_KID_LOG_DIR=

# 多用户: 当前用户ID (默认: 空=default)
# CHARLIE_USER_ID=

# 跳过后台调度器 (HTTP进程管理时设为1)
# SKIP_BACKGROUND=0

# 日志格式 (默认: 标准格式)
# LOG_FORMAT=

# MCP服务器列表 (逗号分隔)
# MCP_SERVERS=

# 意图分类熔断参数
# ASSISTANT_KID_INTENT_FAILURE_THRESHOLD=
# ASSISTANT_KID_INTENT_FAILURE_COOLDOWN=
# 重试延时上限(秒)
# ASSISTANT_KID_RETRY_AFTER_CAP=

# Finna TTS合成参数 (qwen3-tts-flash)
# TTS_VOICE= 音色名 (默认: Cherry, 仅作缓存key隔离)
# TTS_CACHE_MAX_CHARS= 短文本缓存上限(字符, 默认20)
# TTS_FAILURE_THRESHOLD= 连续失败熔断阈值 (默认3)
# TTS_FAILURE_COOLDOWN= 熔断冷却秒数 (默认120)
# LOCAL_TTS_ENABLED= 本地TTS降级开关 (默认0)

# Finna API (TTS语音合成) — https://www.finna.com.cn
FINNA_API_KEY=你的Finna密钥
# Finna API base地址
# FINNA_BASE=

# Tavily搜索 — https://tavily.com (免费1000次/月)
TAVILY_API_KEY=

# 阿里云(购物分析) — https://dashscope.aliyuncs.com
ALIYUN_API_KEY=

# 飞书(消息/文档/日历) — https://open.feishu.cn
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 多用户/设备存在检测
# 格式: name=设备名;mac=MAC地址;ip=IP地址, name=设备名2;mac=MAC地址2;ip=IP地址2
# KNOWN_DEVICES=name=我的手机;mac=aa:bb:cc:dd:ee:ff;ip=192.168.1.100
DEFAULT_CITY=北京

# ===== 涂鸦红外空调控制 (2B 开发者 API) =====
# 空调设备若为涂鸦万能红外遥控器(category=qt, 非直连WiFi空调), 2C 终端用户 API
# (TUYA_API_KEY 的 sk- Bearer key) 的 shadow/properties/issue 只更新影子不触发红外发码,
# 必须用 2B 开发者红外云 API。凭证: iot.tuya.com -> 云开发 -> 你的云项目 -> 获取授权。
TUYA_CLIENT_ID=
TUYA_ACCESS_KEY=
# 红外网关设备 ID(即空调遥控器 device id, 与 2C 的 TUYA_AC_DEVICE_ID 同一个)
# TUYA_AC_DEVICE_ID=6c7347f1e4f47ddb07hejn
# 验证: python tuya_ir_verify.py status (只读) / on / off
