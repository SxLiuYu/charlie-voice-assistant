# 魔幻手机 API密钥配置模板
# 复制此文件为 .env 并填入真实密钥
# cp .env.example .env

# GLM-5.2 大脑 (finna中转)
GLM_KEY=your-glm-key-here
GLM_MODEL=glm-5.2
FINNA_BASE=https://www.finna.com.cn/v1

# 语音 ASR/TTS (finna中转)
TTS_KEY=your-tts-key-here
ASR_KEY=your-asr-key-here
TTS_VOICE=Cherry

# 高德地图 (https://lbs.amap.com)
AMAP_KEY=your-amap-key-here

# Tavily搜索 (https://tavily.com)
TAVILY_API_KEY=your-tavily-key-here

# 阿里云 qwen-max (https://dashscope.aliyun.com)
ALIYUN_API_KEY=your-aliyun-key-here

# MCP服务器配置(逗号分隔, 默认4个核心服务器, 省内存)
# 可选: amap-maps,magic-phone,baize-skills,filesystem,memory,sequential-thinking
MCP_SERVERS=amap-maps,magic-phone,baize-skills,filesystem

# 文件系统MCP根目录(默认项目上级目录)
FS_ROOT=/Users/sxliuyu/orca/projects/傻妞
