# ============================================
# 魔幻手机 · API密钥配置模板
# ============================================
# 复制此文件为 .env 并填入真实密钥
# cp .env.example .env

# === deepseek-v4-flash 大脑 (finna中转) ===
GLM_KEY=your-glm-key-here
GLM_MODEL=deepseek-v4-flash
FINNA_BASE=https://www.finna.com.cn/v1

# 多密钥故障转移(可选, GLM_KEY失败后自动轮换到GLM_KEY_2...)
# GLM_KEY_2=your-backup-key
# GLM_KEY_3=another-backup-key

# === 语音 ASR/TTS (finna中转) ===
TTS_KEY=your-tts-key-here
ASR_KEY=your-asr-key-here
TTS_VOICE=Cherry
TTS_MODEL=qwen3-tts-flash

# 本地 ASR 微服务 (SenseVoiceSmall, FunASR+MLX, Mac Mini M4)
# 启用后优先使用本地 ASR, 失败时 fallback 到 Finna 云端
# LOCAL_ASR_URL=http://127.0.0.1:8766/asr
# LOCAL_ASR_ENABLED=1

# 本地 TTS 微服务 (Qwen3-TTS-0.6B-4bit, mlx-audio, Mac Mini M4)
# 启用后短文本(≤10字)走本地 TTS, 失败时 fallback 到 Finna 云端
# LOCAL_TTS_URL=http://127.0.0.1:8767
# LOCAL_TTS_ENABLED=1

# 短期TTS音频缓存(可选): 重复短句只合成一次，降低TTS 429概率
# ASSISTANT_KID_TTS_CACHE_TTL=300
# ASSISTANT_KID_TTS_CACHE_MAX=128
# ASSISTANT_KID_TTS_CACHE_MAX_CHARS=80
# ASSISTANT_KID_TTS_FAILURE_COOLDOWN=5

# === 高德地图 (https://lbs.amap.com) ===
AMAP_KEY=your-amap-key-here
# 可选：ESP32 室内 WiFi 扫描定位设备地址，用于 baize_skills_mcp.get_location()
# ESP32_IP=192.168.1.7

# === Tavily搜索 (https://tavily.com) ===
TAVILY_API_KEY=your-tavily-key-here

# === 阿里云 qwen-max (https://dashscope.aliyun.com) ===
# 用于购物分析、翻译等辅助任务
ALIYUN_API_KEY=your-aliyun-key-here

# === MCP服务器配置(逗号分隔) ===
# 可选: amap-maps,magic-phone,baize-skills,filesystem,memory,sequential-thinking
# 默认4个核心服务器(省内存), 全开需~8GB内存
MCP_SERVERS=amap-maps,magic-phone,baize-skills,filesystem

# 文件系统MCP根目录(默认项目上级目录)
FS_ROOT=/path/to/your/projects

# 测试或便携部署时可覆盖运行态数据/日志目录；默认分别为项目根目录和 logs/
# ASSISTANT_KID_DATA_DIR=/path/to/data
# ASSISTANT_KID_LOG_DIR=/path/to/logs
# start_tunnel.sh / watchdog.sh 也会复用 ASSISTANT_KID_LOG_DIR；
# 如需单独指定，可覆盖 cloudflared 和看门狗日志路径。
# CLOUDFLARED_LOG_FILE=/path/to/logs/cloudflared.log
# WATCHDOG_LOG=/path/to/logs/watchdog.log
# VOICE_SERVER_LOG=/path/to/logs/voice_srv.log
# HTTPS_SERVER_LOG=/path/to/logs/voice_https.log
# HTTP/HTTPS 监听端口；/api/status 和 /dashboard 会显示同一组局域网访问地址
# ASSISTANT_KID_HTTP_PORT=8000
# ASSISTANT_KID_HTTPS_PORT=8443
# 额外允许的浏览器跨域来源，多个用逗号分隔；默认只放行 localhost、局域网 IP 和 cloudflared 隧道。
# 不要填写 "*"；需要公网页面访问时显式填写完整 origin，例如 https://phone.example:8443
# ASSISTANT_KID_CORS_ORIGINS=https://phone.example:8443
# 429 Retry-After 的单次等待上限(秒)，默认5秒，防止外部服务要求等待过久
# ASSISTANT_KID_RETRY_AFTER_CAP=5
# 本地 Ollama 意图分类连续失败多少次后短熔断，默认2次
# ASSISTANT_KID_INTENT_FAILURE_THRESHOLD=2
# 本地 Ollama 意图分类熔断冷却秒数，默认30秒；冷却期内直接降级 none
# ASSISTANT_KID_INTENT_FAILURE_COOLDOWN=30

# === 安全与运维 ===
# API令牌认证(设置后公网访问需Bearer令牌, 留空则不认证)
AUTH_TOKEN=

# 仅在可信反向代理后启用：允许读取 X-Forwarded-For/X-Real-IP。
# 默认关闭，外部请求无法通过伪造代理头绕过 AUTH_TOKEN 或本机免认证。
# ASSISTANT_KID_TRUST_PROXY_HEADERS=0

# 日志格式: text(默认) 或 json(便于日志聚合系统收集)
# LOG_FORMAT=json

# HTTPS进程跳过后台调度(多进程部署时防重复播报)
# SKIP_BACKGROUND=1

# === 京东联盟(购物, 可选) ===
# JD_APP_KEY=your-jd-app-key
# JD_SECRET_KEY=your-jd-secret-key

# === 特斯拉Fleet API(可选, 需Tesla Developer授权) ===
# TESLA_CLIENT_ID=your-tesla-client-id
# TESLA_CLIENT_SECRET=your-tesla-client-secret
