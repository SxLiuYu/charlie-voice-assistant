# ============================================
# 魔幻手机 · API密钥配置模板
# ============================================
# 复制此文件为 .env 并填入真实密钥
# cp .env.example .env

# === GLM-5.2 大脑 (finna中转) ===
GLM_KEY=your-glm-key-here
GLM_MODEL=glm-5.2
FINNA_BASE=https://www.finna.com.cn/v1

# 多密钥故障转移(可选, GLM_KEY失败后自动轮换到GLM_KEY_2...)
# GLM_KEY_2=your-backup-glm-key
# GLM_KEY_3=another-backup-key

# === 语音 ASR/TTS (finna中转) ===
TTS_KEY=your-tts-key-here
ASR_KEY=your-asr-key-here
TTS_VOICE=Cherry

# === 高德地图 (https://lbs.amap.com) ===
AMAP_KEY=your-amap-key-here

# === Tavily搜索 (https://tavily.com) ===
TAVILY_API_KEY=your-tavily-key-here

# === 阿里云 qwen-max (https://dashscope.aliyun.com) ===
# 用于购物分析、翻译等辅助任务
ALIYUN_API_KEY=your-aliyun-key-here

# === MCP服务器配置(逗号分隔) ===
# 可选: amap-maps,magic-phone,baize-skills,filesystem,memory,sequential-thinking
# 默认4个核心服务器(省内存), 全开需~8GB内存
MCP_SERVERS=amap-maps,magic-phone,baize-skills,filesystem

# 文件系统MCP根目录(默认项目上级目录)
FS_ROOT=/Users/sxliuyu/orca/projects

# === 安全与运维 ===
# API令牌认证(设置后公网访问需Bearer令牌, 留空则不认证)
AUTH_TOKEN=

# 日志格式: text(默认) 或 json(便于日志聚合系统收集)
# LOG_FORMAT=json

# HTTPS进程跳过后台调度(多进程部署时防重复播报)
# SKIP_BACKGROUND=1

# === 京东联盟(购物, 可选) ===
# JD_APP_KEY=your-jd-app-key
# JD_SECRET_KEY=your-jd-secret-key

# === 特斯拉Fleet API(可选, 需Tesla Developer授权) ===
# TESLA_CLIENT_ID=your-tesla-client-id
# TESLA_CLIENT_SECRET=your-tesla-client-secret
